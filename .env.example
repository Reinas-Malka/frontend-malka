VITE_API_BASE_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
# Login (#6): salen de outputs de Terraform; no son secretas (terminan en el
# bundle). Redirect y logout NO van acá: se derivan de window.location.origin.
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=malka-suite-dev-xxxxxx.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REGION=us-east-1
# Solo desarrollo (#15): URL prefirmada de S3 generada a mano con la CLI,
# para probar la subida de documentos sin el endpoint del backend.
# VITE_URL_SUBIDA_FICTICIA=
# Datos de ejemplo del negocio en toda la app, SIN login (true solo en desarrollo/demos)
VITE_DATOS_SIMULADOS=false
